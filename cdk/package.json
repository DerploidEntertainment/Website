{
  "name": "github-pages-website-cdk",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Derploid® Entertainment, LLC",
    "email": "contact@derploid.com",
    "url": "https://derploid.com"
  },
  "bin": {
    "github-pages-website-cdk": "bin/github-pages-website-cdk.js"
  },
  "scripts": {
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "test": "jest",
    "synth": "cdk synth -- $@",
    "synth:test": "export NODE_ENV=test && npm run synth -- $@",
    "synth:prod": "export NODE_ENV=prod && npm run synth -- $@",
    "diff": "cdk diff --app cdk.out/",
    "import": "cdk import --app cdk.out/",
    "deploy": "cdk deploy --app cdk.out/",
    "deploy:test": "npm run deploy -- $@",
    "deploy:prod": "npm run deploy -- $@"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "aws-cdk": "^2.1134.0",
    "jest": "^30.4.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.262.2",
    "constructs": "^10.8.0",
    "dotenv": "^17.4.2"
  }
}
